  m_Name: 
  m_EditorClassIdentifier: 
  name_: Entrance
  stats:
    health: 0
    maxHealth: 0
    fortitude: 0
    strength: 0
    agility: 0
    faith: 0
  threatRelationshipValue: 0
  allegianceRelationshipValue: 0
