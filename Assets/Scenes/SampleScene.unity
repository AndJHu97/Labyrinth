  m_Name: 
  m_EditorClassIdentifier: 
  name_: Entrance
  stats:
    health: 0
    maxHealth: 0
    fortitude: 0
    strength: 0
    agility: 0
    faith: 0
  threatRelationshipValue: 0
  allegianceRelationshipValue: 0
  isActive: 1
  conditionConsequences: []
  triggeredResponses: []
  UniqueResponseToPlayerDisplayTexts: []
  allActionsOnObject: []
  rightObject: {fileID: 101243566}
  leftObject: {fileID: 654454520}
  upObject: {fileID: 1187713604}
  downObject: {fileID: 114154928}
  straightAheadObject: {fileID: 174510152}
  behindObject: {fileID: 1994238328}
  roomDescription:
  - 'Consciousness explodes life into this body. Despite the awareness returning,
    the memories did not. You don''t know who you are... and you don''t know how
    to use this body. Glass shards sprinkle all around you, and water drips off you
    as you stand up.  '
  - 'A damp and muggy musk wafts by, stabilizing you back to reality. Stone blocks
    line the walls, shunting any light except the faint glow of the two entrances
    ahead and the luminescence of a broken, jagged glass chamber behind you. '
  - 'The entrance farthest from you is a door with chains and locks. Right in front
    of the door is a man with a white, stringy beard who is curled up against the
    right wall, muttering nonsense to himself: "He is not the one. I am the one.
    I am the true one..." Another door to your left and a deep abyss craters the
    center of this room. This place provides you no comfort. '
--- !u!4 &1555009311
