  m_Name: 
  m_EditorClassIdentifier: 
  name_: Prayer Zone of Shifts
  stats:
    health: 0
    maxHealth: 0
    fortitude: 0
    strength: 0
    agility: 0
    faith: 0
  threatRelationshipValue: 0
  allegianceRelationshipValue: 0
  isActive: 1
  conditionConsequences: []
  triggeredResponses: []
  UniqueResponseToPlayerDisplayTexts: []
  allActionsOnObject: []
  rightObject: {fileID: 217239974}
  leftObject: {fileID: 263837915}
  upObject: {fileID: 1764447799}
  downObject: {fileID: 787562342}
  straightAheadObject: {fileID: 1132077928}
  behindObject: {fileID: 1751200703}
  roomDescription:
  - 'The room opens up to a calmer and livelier environment. The people here are
    clothed in garments of long, clean brown robes, the same as the group at the
    graveyard. Smiles sprinkle throughout the area. At the center of the room, there
    is a large stone symbol of the number "0", with a circle of people praying around
    it and lighting candles. '
  - 'A person with a prominent red robe resides alone on the left side of the room.
    His importance is accentuated by a crown with the number 0 on the front. To the
    right is a family of three, the only ones here without brown robes; instead,
    they are clothed in ragged pieces of cloth. Like everyone else, they look similar
    to everyone else you have met here, even the mom. '
--- !u!4 &1476058907
