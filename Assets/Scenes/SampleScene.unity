    - target: {fileID: 4517803644221680943, guid: 31f9b1a2b3dc1074ba162aac78010875, type: 3}
      propertyPath: conditionConsequences.Array.data[3].successfulConsequences.Array.data[0].displayTexts.Array.data[0]
      value: 'You stare at the broken glass chamber behind you. Fear grips you, keeping
        you at a standstill. "I can''t do this anymore. The pain and suffering, it
        never stops." The voice in your head says. You have no definitive idea of
        the message behind it, but it keeps you stricken with fear. '
      objectReference: {fileID: 0}
