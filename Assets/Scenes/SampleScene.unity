      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8789052347634187005, guid: 199e7796804b24c4b9e064336d16bbc7, type: 3}
      propertyPath: UniqueResponseToPlayerDisplayTexts.Array.data[0].displayTexts.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 8789052347634187005, guid: 199e7796804b24c4b9e064336d16bbc7, type: 3}
      propertyPath: UniqueResponseToPlayerDisplayTexts.Array.data[0].displayTexts.Array.data[0]
      value: 'The door is straight ahead of you. This door looks pristine. The old
        man sits to the side of the door. '
      objectReference: {fileID: 0}
    - target: {fileID: 8789052347634187005, guid: 199e7796804b24c4b9e064336d16bbc7, type: 3}
      propertyPath: conditionConsequences.Array.data[0].conditions.Array.data[2].actionConditions.Array.data[0].room
      value: 
      objectReference: {fileID: 1555009310}
    - target: {fileID: 8789052347634187005, guid: 199e7796804b24c4b9e064336d16bbc7, type: 3}
      propertyPath: conditionConsequences.Array.data[0].successfulConsequences.Array.data[0].displayTexts.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 8789052347634187005, guid: 199e7796804b24c4b9e064336d16bbc7, type: 3}
      propertyPath: conditionConsequences.Array.data[0].conditions.Array.data[1].activeConditions.Array.data[0].target
      value: 
      objectReference: {fileID: 101243566}
    - target: {fileID: 8789052347634187005, guid: 199e7796804b24c4b9e064336d16bbc7, type: 3}
      propertyPath: conditionConsequences.Array.data[0].successfulConsequences.Array.data[0].displayTexts.Array.data[0]
      value: 'You walk to the door ahead, passing the man to your right. He slumps
        to the ground, his back against the wall. Drool dribbles down his white,
        wispy beard. As you put your hand on the doorknob, a primordial yell stops
        you in your tracks. Confidence drained, you dare not turn to see this source,
        but your instincts kick in to protect yourself. Too late. '
      objectReference: {fileID: 0}
    - target: {fileID: 8789052347634187005, guid: 199e7796804b24c4b9e064336d16bbc7, type: 3}
      propertyPath: conditionConsequences.Array.data[0].successfulConsequences.Array.data[0].displayTexts.Array.data[1]
      value: 'Bloodshot eyes. Rancid breath. Violent guttural sounds. These fill
        your senses. You try to push him away, but for a wasted man, he has a lot
        of strength. His head jerks back, and forward it goes, headbutting you in
        the face. Dazed, you try to escape his grasp, but you cannot. He jerks back
        again. Then his head crashes down to your neck, teeth clamped down on your
        skin and meat. You feel a tearing pain, and when he pulls away, you see a
        chunk of meat in his mouth. Red, warm trickles down your chest. Pain seizes
        your body. The old man grinds the meat in his mouth as he glares at you as
        he return to his wall. '
      objectReference: {fileID: 0}
    - target: {fileID: 8789052347634187005, guid: 199e7796804b24c4b9e064336d16bbc7, type: 3}
      propertyPath: conditionConsequences.Array.data[0].conditions.Array.data[0].relationshipConditions.Array.data[0].target
      value: 
      objectReference: {fileID: 101243566}
