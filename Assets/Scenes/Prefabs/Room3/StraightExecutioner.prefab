      - {fileID: 11400000, guid: ddc019fc6e55f7d449e1e392cf1f4cbf, type: 2}
      relationshipConsequences: []
      activeConsequences: []
      netHealthImpact: []
      statConsequences: []
      displayTexts:
      - 'You look at the man in the robe with a mask and a giant axe in hand. You
        hand him the crying baby in hand. He laughs and giggles, repeating, "I am
        executioner, I am executioner." You couldn''t bear to watch, so you turn
        away. Soon, you hear a swift swoosh, and the crying stops. '
      - '"You fool!" You heard the Priest on the left yell. Immediately, two robed
        men hold the executioner and carry him away. They take him to another room
        where you can hear screams and cries coming from him that are immediately
        silenced. A new executioner takes his place.'
      - '"That imbecile," The Priest snarls. "A baby is a 0, a worthy candidate to
        be a Vessel. Newborns are rare, almost nil, down here. Now we must work the
        female extra hard, for she is the only one capable of reproducing."'
      experiencePointsChange: 0
    failingConsequences: []
  triggeredResponses: []
  UniqueResponseToPlayerDisplayTexts:
  - name_: Voice
    UseEmotionKey: 0
    emotionKey: 0
    UseMotorSensorKey: 1
    motorSensorKey: 3
    displayTexts:
    - 'You tried talking to the man in a robe with a mask and a giant axe in hand.
      His mask is pearly white, with two hollow holes for the eyes and one for the
      mouth. He grunts out, "I am an executioner." That is all he says, or perhaps
      all he is capable of saying. '
  - name_: Observation
    UseEmotionKey: 0
    emotionKey: 0
    UseMotorSensorKey: 1
    motorSensorKey: 4
    displayTexts:
    - 'Ahead of you is a man who, even under the brown robe, you can tell is broad-shouldered.
      His pearly-white mask occludes any expression. The mask is smooth and harrowing,
      with only two black holes for eyes, and one extra for the mouth. He stands
      with a giant axe in hand, unmoving. '
