  UniqueResponseToPlayerDisplayTexts:
  - name_: Observation
    UseEmotionKey: 0
    emotionKey: 0
    UseMotorSensorKey: 1
    motorSensorKey: 4
    displayTexts:
    - 'You look at the prayer site in the middle. Unlike the one in the graveyard,
      this one contained no tombstones. Only a large "0" in the middle, surrounded
      by illuminated candles and robed men chanting. '
  - name_: Voice
    UseEmotionKey: 0
    emotionKey: 0
    UseMotorSensorKey: 1
    motorSensorKey: 3
    displayTexts:
    - 'The robed people at the Prayer Site in the center ignore your greetings, and
      instead they gossip about some sort of tragedy that befell the Uncounted Base. '
    - '"Hand of S really showed them with that punishment." "I heard at least 5 people
      were crushed." "This is what they get for defying the Spawns."'
  allActionsOnObject: []
